# Copy this to .env and fill in your values
# Example for MongoDB Atlas or local MongoDB.
# Use a MongoDB Atlas Database Access username/password, not your Atlas login.
# URL-encode special characters in the password, for example @ becomes %40.
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pingup?retryWrites=true&w=majority
# If you prefer, use MONGODB_URI instead:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net

# Clerk auth environment variables (if you use Clerk)
# CLERK_API_KEY=...
# CLERK_JWT_KEY=...
